[
  {
    "label": "bludio: build",
    "command": "cargo",
    "args": ["build"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false
  },
  {
    "label": "bludio: run",
    "command": "cargo",
    "args": ["run"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false
  },
  {
    "label": "bludio: check",
    "command": "cargo",
    "args": ["check"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false
  },
  {
    "label": "bludio: test",
    "command": "cargo",
    "args": ["test"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false
  },
  {
    "label": "bludio: clippy",
    "command": "cargo",
    "args": ["clippy", "--", "-D", "warnings"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false
  },
  {
    "label": "bludio: clean + build",
    "command": "cargo",
    "args": ["clean"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false,
    "allow_concurrent_runs": false
  },
  {
    "label": "bludio: fmt check",
    "command": "cargo",
    "args": ["fmt", "--", "--check"],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": false
  }
]
